# ---------------------------------------------------------------------------
# BDGiftora.com — environment variables
# Copy this file to `.env.local` (development) or set the same vars in your
# Vercel project settings (production). NEVER commit `.env.local`.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# IMPORTANT: Prisma does not allow `provider = env(...)`, so you must edit
# `prisma/schema.prisma` directly when switching between local SQLite and
# production Postgres.
#
# Local development (SQLite — matches the existing /db/custom.db file):
#   1. In prisma/schema.prisma, set `provider = "sqlite"`
#   2. Set DATABASE_URL="file:./db/custom.db" below
#   3. Run: bun run db:push && bun run db:seed
#
# Production (Supabase Postgres pooler + direct connection):
#   1. In prisma/schema.prisma, set `provider = "postgresql"`
#   2. Set the URLs below to your Supabase pooler + direct connection strings
DATABASE_URL="file:./db/custom.db"
DIRECT_URL="file:./db/custom.db"

# --- Auth ------------------------------------------------------------------
# Any long random string (used to HMAC-sign the session cookie).
# Generate one with:  openssl rand -hex 32
AUTH_SECRET="change-me-to-a-long-random-hex-string"

# Initial admin password (only used by `bun run db:seed` to create the
# admin user; can be changed later from the admin UI).
ADMIN_PASSWORD="admin123"

# --- Supabase Storage (admin image uploads) --------------------------------
# Leave blank in dev to fall back to local /public/uploads/.
# In production these come from your Supabase project settings.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# --- Public site URL (used for metadata + sitemap) -------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
