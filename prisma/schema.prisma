// Prisma schema — UpoharBd clone (SQLite-adapted)
// Money stored as Decimal (Prisma maps to TEXT in SQLite). Json stored as TEXT.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  MANAGER
  EDITOR
}

enum ProductType {
  PHYSICAL
  DIGITAL
  PERSONALISED
}

enum StockMode {
  UNLIMITED
  TRACKED
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  PAID
  PROCESSING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  AWAITING_VERIFICATION
}

model City {
  id              Int      @id @default(autoincrement())
  slug            String   @unique
  name            String
  nameBn          String?
  deliveryFeeBdt  Decimal  @default(0)
  isFreeDelivery  Boolean  @default(false)
  sameDayCutoff   String?
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  categories      Category[]
  deliveries      Delivery[]
  slotRules       DeliverySlotRule[]
}

model Category {
  id            Int       @id @default(autoincrement())
  legacyId      Int?      @unique
  slug          String
  parentId      Int?
  parent        Category? @relation("Tree", fields: [parentId], references: [id])
  children      Category[] @relation("Tree")
  cityId        Int?
  city          City?     @relation(fields: [cityId], references: [id])
  icon          String?
  imageUrl      String?
  showInSidebar Boolean   @default(true)
  sortOrder     Int       @default(0)
  isActive      Boolean   @default(true)
  i18n          CategoryI18n[]
  products      ProductCategory[]
  @@unique([parentId, slug, cityId])
}

model CategoryI18n {
  id            Int      @id @default(autoincrement())
  categoryId    Int
  locale        String
  name          String
  description   String?
  seoTitle      String?
  seoDescription String?
  category      Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  @@unique([categoryId, locale])
}

model Product {
  id            Int       @id @default(autoincrement())
  legacyId      Int?      @unique
  sku           String    @unique
  slug          String    @unique
  type          ProductType @default(PHYSICAL)
  priceBdt      Decimal
  salePriceBdt  Decimal?
  stockMode     StockMode @default(UNLIMITED)
  stockQty      Int?
  isCake        Boolean   @default(false)
  vendorId      Int?
  vendor        Vendor?   @relation(fields: [vendorId], references: [id])
  firstSoldYear Int?
  orderCount    Int       @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  i18n          ProductI18n[]
  images        ProductImage[]
  categories    ProductCategory[]
  variants      ProductVariant[]
  relatedFrom   RelatedProduct[] @relation("From")
  relatedTo     RelatedProduct[] @relation("To")
  cartItems     CartItem[]
  orderItems    OrderItem[]
}

model ProductI18n {
  id                Int      @id @default(autoincrement())
  productId         Int
  locale            String
  name              String
  shortDescription  String?
  description       String?
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([productId, locale])
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  url       String
  alt       String?
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVariant {
  id        Int     @id @default(autoincrement())
  productId Int
  label     String
  sku       String  @unique
  priceBdt  Decimal
  stockQty  Int?
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductCategory {
  productId  Int
  categoryId Int
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  @@id([productId, categoryId])
}

model RelatedProduct {
  fromId Int
  toId   Int
  from   Product @relation("From", fields: [fromId], references: [id], onDelete: Cascade)
  to     Product @relation("To", fields: [toId], references: [id], onDelete: Cascade)
  @@id([fromId, toId])
}

model Vendor {
  id       Int       @id @default(autoincrement())
  name     String
  slug     String    @unique
  products Product[]
}

model Currency {
  code        String   @id
  symbol      String
  name        String
  rateFromBdt Decimal
  updatedAt   DateTime @default(now())
  isActive    Boolean  @default(true)
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?
  title        String?
  firstName    String?
  lastName     String?
  phone1       String?
  phone2       String?
  role         Role      @default(CUSTOMER)
  addresses    Address[]
  orders       Order[]
  cart         Cart?
  createdAt    DateTime  @default(now())
}

model Address {
  id        Int     @id @default(autoincrement())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  line1     String
  line2     String?
  area      String
  postcode  String?
  country   String
  region    String
  isDefault Boolean @default(false)
}

model Cart {
  id         String     @id @default(cuid())
  userId     String?    @unique
  user       User?      @relation(fields: [userId], references: [id])
  currency   String     @default("USD")
  couponCode String?
  updatedAt  DateTime   @updatedAt
  items      CartItem[]
}

model CartItem {
  id             Int     @id @default(autoincrement())
  cartId         String
  cart           Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId      Int
  product        Product @relation(fields: [productId], references: [id])
  variantId      Int?
  qty            Int
  cakeMessage    String?
  personalisation String?
}

model Order {
  id            String       @id @default(cuid())
  orderNo       String       @unique
  userId        String?
  user          User?        @relation(fields: [userId], references: [id])
  status        OrderStatus  @default(PENDING)
  currency      String
  exchangeRate  Decimal
  subtotalBdt   Decimal
  discountBdt   Decimal      @default(0)
  deliveryBdt   Decimal      @default(0)
  totalBdt      Decimal
  couponId      Int?
  invTitle      String?
  invFirstName  String
  invLastName   String
  invEmail      String
  invPhone1     String
  invPhone2     String?
  invAddress1   String
  invAddress2   String?
  invArea       String
  invPostcode   String?
  invCountry    String
  invRegion     String
  ipAddress     String?
  items         OrderItem[]
  delivery      Delivery?
  payments      Payment[]
  events        OrderEvent[]
  createdAt     DateTime     @default(now())
}

model OrderItem {
  id            Int     @id @default(autoincrement())
  orderId       String
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     Int
  product       Product @relation(fields: [productId], references: [id])
  variantId     Int?
  nameSnapshot  String
  skuSnapshot   String
  unitPriceBdt  Decimal
  qty           Int
  cakeMessage   String?
  personalisation String?
}

model Delivery {
  id            Int      @id @default(autoincrement())
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  recipientName String
  recipientPhone String
  address       String
  area          String
  cityId        Int
  city          City     @relation(fields: [cityId], references: [id])
  deliveryDate  DateTime
  timeSlot      String
  cardMessage   String?
  hideSender    Boolean  @default(false)
  notes         String?
  photoProofUrl String?
  deliveredAt   DateTime?
}

model Payment {
  id        Int            @id @default(autoincrement())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider  String
  method    String?
  amount    Decimal
  currency  String
  status    PaymentStatus  @default(PENDING)
  txnRef    String?
  proofUrl  String?
  raw       String?
  createdAt DateTime       @default(now())
}

model OrderEvent {
  id        Int      @id @default(autoincrement())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String
  note      String?
  actorId   String?
  createdAt DateTime @default(now())
}

model Coupon {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  kind        String
  value       Decimal
  minOrderBdt Decimal?
  appliesTo   String?
  startsAt    DateTime?
  endsAt      DateTime?
  usageLimit  Int?
  usedCount   Int      @default(0)
  isActive    Boolean  @default(true)
}

model Banner {
  id        Int      @id @default(autoincrement())
  placement String
  title     String
  imageUrl  String?
  link      String?
  payload   String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
}

model Testimonial {
  id        Int      @id @default(autoincrement())
  name      String
  country   String
  message   String
  rating    Int      @default(5)
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model CmsPage {
  id             Int      @id @default(autoincrement())
  slug           String
  locale         String
  title          String
  body           String
  metaTitle      String?
  metaDescription String?
  @@unique([slug, locale])
}

model Setting {
  key   String @id
  value String
}

model DeliverySlotRule {
  id        Int     @id @default(autoincrement())
  cityId    Int?
  city      City?   @relation(fields: [cityId], references: [id])
  label     String
  startTime String
  endTime   String
  capacity  Int     @default(50)
  isActive  Boolean @default(true)
}

model BlockedDate {
  id     Int      @id @default(autoincrement())
  date   DateTime @unique
  reason String?
  cityId Int?
}
